<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    
    <com.limelight.ui.StreamContainer
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true">
    <requestFocus />
    </com.limelight.ui.StreamContainer>

<!--    <com.limelight.ui.ApertureViewGroup-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        app:aperture_color1="#5CF950"-->
<!--        android:layout_gravity="center"-->
<!--        android:padding="5dp"-->
<!--        app:aperture_color2="#FC9595"-->
<!--        app:aperture_border_width="10dp"-->
<!--        app:aperture_border_angle="24dp"-->
<!--        app:aperture_duration="6000"-->
<!--        app:aperture_middle_color="#6CD2F8">-->
<!--    </com.limelight.ui.ApertureViewGroup>-->

    <!-- The overlays over the stream are Compose (app.sloplight.ui.stream); their
         views are put in these containers only while they show -->

    <!-- The transient notice ("slow connection") -->
    <FrameLayout
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="top|end"
        android:visibility="gone" />

    <!-- The performance overlay (full: start, lite: centered; top, or bottom if asked) -->
    <FrameLayout
        android:id="@+id/performanceOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Floating Menu Button (its look is Compose, its touches Game's) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/floatingMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/menu_button"
        android:visibility="gone"
        android:elevation="9999dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/overlayToggleZoomButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/toggle_pan_zoom_mode"
        android:visibility="gone"
        android:elevation="9999dp" />

</merge>